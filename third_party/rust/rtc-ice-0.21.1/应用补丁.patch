+            if self.local_candidates[index].can_pair_with(&self.remote_candidates[remote])
+                && self.find_pair(index, remote).is_none() {
+                self.add_pair(index, remote);
+            }
+        }
+        self.request_connectivity_check();
+        true
+    }
