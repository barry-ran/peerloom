+#[test]
+fn trickle_nomination_blocks_new_convey_but_allows_admitted_write_completion() -> Result<()> {
+    let mut a = Agent::new(Instant::now(), Arc::new(AgentConfig::default()), test_crypto_provider())?;
+    a.set_trickle_mode(true);
+    let first = trickle_test_host(10000);
+    let second = trickle_test_host(10002);
+    a.add_local_candidate(first.clone())?;
+    a.add_remote_candidate(trickle_test_host(10001))?;
+    a.add_local_candidate(second.clone())?;
+    assert!(a.begin_local_candidate_convey(&first));
+    assert!(a.ack_local_candidate_conveyed(&first));
+    assert!(a.begin_local_candidate_convey(&second));
+    a.selected_pair = Some(0);
+    assert!(!a.begin_local_candidate_convey(&first));
+    assert!(a.ack_local_candidate_conveyed(&second));
+    assert_eq!(a.candidate_pairs.len(), 1);
+    assert!(!a.local_gathering_complete());
+    assert!(!a.remote_gathering_complete());
+    Ok(())
+}
