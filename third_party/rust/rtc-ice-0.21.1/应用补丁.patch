+    /// Enable before candidate gathering. Candidates must be acknowledged after
+    /// ordered signaling admission before they may form connectivity-check pairs.
+    pub fn set_trickle_mode(&mut self, enabled: bool) {
+        self.trickle_mode = enabled;
+        if !enabled {
+            self.unconveyed_local_candidates.clear();
+            self.conveying_local_candidates.clear();
+        }
+    }
+
+    /// Record actual local gathering completion; pending convey acknowledgements still gate failure.
+    pub fn mark_local_gathering_complete(&mut self) {
+        self.local_gathering_complete = true;
+        self.request_connectivity_check();
+    }
+
+    /// Record the remote end-of-candidates marker for the current ICE generation.
+    pub fn mark_remote_gathering_complete(&mut self) {
+        self.remote_gathering_complete = true;
+        self.request_connectivity_check();
+    }
+
+    /// Whether local gathering has completed in this generation.
+    pub fn local_gathering_complete(&self) -> bool { self.local_gathering_complete }
+    /// Whether remote EOC has been received in this generation.
+    pub fn remote_gathering_complete(&self) -> bool { self.remote_gathering_complete }
+
+    /// Linearize the start of an ordered signaling write before nomination.
+    /// A previously admitted write may finish, but no new write begins afterwards.
+    pub fn begin_local_candidate_convey(&mut self, candidate: &Candidate) -> bool {
+        if !self.trickle_mode || self.selected_pair.is_some() { return false; }
+        let Some(index) = self.local_candidates.iter().position(|c| c.equal(candidate)) else { return false; };
+        if !self.unconveyed_local_candidates.contains(&index) || self.conveying_local_candidates.contains(&index) { return false; }
+        self.conveying_local_candidates.push(index);
+        true
+    }
+
+    /// Acknowledge only this generation's successfully conveyed candidate.
+    /// Duplicate acknowledgements are harmless; unknown candidates are not added.
+    pub fn ack_local_candidate_conveyed(&mut self, candidate: &Candidate) -> bool {
+        let Some(index) = self.local_candidates.iter().position(|c| c.equal(candidate)) else {
+            return false;
+        };
+        let Some(pending) = self.unconveyed_local_candidates.iter().position(|i| *i == index) else {
+            return false;
+        };
+        let Some(inflight) = self.conveying_local_candidates.iter().position(|i| *i == index) else { return false; };
+        self.conveying_local_candidates.remove(inflight);
+        self.unconveyed_local_candidates.remove(pending);
+        if self.selected_pair.is_some() { return true; }
