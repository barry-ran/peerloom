+#[test]
+fn trickle_remote_eoc_ignores_signaling_but_keeps_authenticated_discovery() -> Result<()> {
+    let mut a = Agent::new(Instant::now(), Arc::new(AgentConfig::default()), test_crypto_provider())?;
+    a.set_trickle_mode(true);
+    a.mark_remote_gathering_complete();
+    assert!(!a.add_remote_candidate(trickle_test_host(10001))?);
+    assert!(a.remote_candidates.is_empty());
+    assert!(a.add_remote_candidate_inner(trickle_test_host(10002))?);
+    assert_eq!(a.remote_candidates.len(), 1);
+    Ok(())
+}
