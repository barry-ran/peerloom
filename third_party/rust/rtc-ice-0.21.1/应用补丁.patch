+fn trickle_test_host(port: u16) -> Candidate {
+    CandidateHostConfig { base_config: CandidateConfig {
+        network: "udp".into(), address: "127.0.0.1".into(), port, component: 1,
+        ..Default::default()
+    }, ..Default::default() }.new_candidate_host().unwrap()
