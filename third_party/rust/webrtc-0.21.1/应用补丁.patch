+    #[test]
+    fn parked_remote_eoc_wakes_without_udp_or_time_advance() { run_case(2); }
+    fn run_case(kind: u8) {
+        let runtime = crate::runtime::default_runtime().unwrap();
+        runtime.block_on(Box::pin(async move {
+            let network = Arc::new(MockUDPNetwork::new());
+            let mock = Arc::new(MockRuntime::with_network(network.clone()));
+            let (mut inner, receiver) = super::super::tests::new_test_peer_connection().await;
+            Arc::get_mut(&mut inner).unwrap().runtime = mock.clone();
+            let local: SocketAddr = "127.0.0.1:55200".parse().unwrap();
+            let remote_addr: SocketAddr = "127.0.0.1:55201".parse().unwrap();
+            let socket = network.bind(local).unwrap();
+            let _remote_socket = network.bind(remote_addr).unwrap();
+            let candidate = |addr: SocketAddr| RTCIceCandidateInit {
+                candidate: format!("candidate:1 1 udp 2130706431 {} {} typ host", addr.ip(), addr.port()),
+                ..Default::default()
+            };
+            let now = mock.now();
+            let mut remote = RTCPeerConnectionBuilder::new().build(now).unwrap();
+            let mut core = inner.core.lock().await;
+            core.enable_trickle_convey().unwrap();
+            core.create_data_channel("wake", None).unwrap();
+            let offer = core.create_offer(None).unwrap();
+            core.set_local_description(now, offer.clone()).unwrap();
+            remote.set_remote_description(now, offer).unwrap();
+            let answer = remote.create_answer(None).unwrap();
+            remote.set_local_description(now, answer.clone()).unwrap();
+            core.set_remote_description(now, answer).unwrap();
+            let ticket = if kind != 2 {
+                core.add_local_candidate(candidate(local)).unwrap();
+                let ticket = core.begin_local_ice_convey(&candidate(local).candidate).unwrap().unwrap();
+                if kind == 1 { core.ack_local_ice_convey(ticket).unwrap(); }
+                if kind == 0 { core.add_remote_candidate(candidate(remote_addr)).unwrap(); }
+                Some(ticket)
+            } else {
+                core.add_local_candidate(RTCIceCandidateInit::default()).unwrap();
+                None
+            };
+            drop(core);
+            let pc = PeerConnectionImpl {
+                inner: inner.clone(), driver_handle: Mutex::new(None),
+                driver_stopped: Mutex::new(None), dedicated_reactor: false,
+            };
+            let mut driver = PeerConnectionDriver::new(inner.clone(), Vec::<SocketAddr>::new(),
+                Vec::new(), MulticastDnsMode::Disabled, Vec::new(), RTCIceTransportPolicy::All,
+                rtc::crypto::default_provider().unwrap(), false, None);
+            driver.udp_sockets.insert(local, socket);
+            driver.test_prebound_transports = true;
+            let (init, mut initialized) = crate::runtime::channel(1);
+            let count = Arc::new(WakeCount(AtomicUsize::new(0)));
+            let waker = futures::task::waker(count.clone());
+            let mut cx = std::task::Context::from_waker(&waker);
+            let mut task = Box::pin(driver.event_loop(DriverInbox::new(receiver), init));
+            assert!(task.as_mut().poll(&mut cx).is_pending());
+            assert!(initialized.try_recv().unwrap().is_ok());
+            assert!(task.as_mut().poll(&mut cx).is_pending());
+            count.0.store(0, Ordering::SeqCst);
+            for _ in 0..8 { assert!(task.as_mut().poll(&mut cx).is_pending()); }
+            assert_eq!(count.0.load(Ordering::SeqCst), 0, "fixture is genuinely parked");
+            if kind == 0 {
+                assert!(pc.ack_local_ice_convey(u64::MAX).await.is_err());
+                assert_eq!(count.0.load(Ordering::SeqCst), 0, "invalid ACK must not schedule work");
+            }
+            match kind {
+                0 => pc.ack_local_ice_convey(ticket.unwrap()).await.unwrap(),
+                1 => pc.add_ice_candidate(candidate(remote_addr)).await.unwrap(),
+                _ => pc.add_ice_candidate(RTCIceCandidateInit::default()).await.unwrap(),
+            }
+            assert!(count.0.load(Ordering::SeqCst) > 0, "actual API must wake parked select without UDP or timer");
+            assert!(task.as_mut().poll(&mut cx).is_pending());
+            assert_eq!(mock.now(), now);
+            assert!(task.as_mut().poll(&mut cx).is_pending());
+            count.0.store(0, Ordering::SeqCst);
+            for _ in 0..32 { assert!(task.as_mut().poll(&mut cx).is_pending()); }
+            assert_eq!(count.0.load(Ordering::SeqCst), 0, "no idle self spin");
+            inner.driver_event_tx.try_send(PeerConnectionDriverEvent::Close).unwrap();
+            assert!(matches!(task.as_mut().poll(&mut cx), std::task::Poll::Ready(Ok(()))), "close remains prompt");
+            assert_eq!(mock.now(), now);
+        }));
+    }
