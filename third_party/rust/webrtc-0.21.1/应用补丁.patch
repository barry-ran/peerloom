+    #[test]
+    fn unpolled_outer_driver_spawn_abort_releases_queued_payload() {
+        let base = crate::runtime::default_runtime().unwrap();
+        let run = base.clone();
+        base.block_on(Box::pin(async move {
+            let (inner, events) = super::super::tests::new_test_peer_connection().await;
+            let dropped = Arc::new(AtomicUsize::new(0));
+            let stream = Arc::new(TrackedStream {
+                read_polled: Arc::new(AtomicBool::new(false)),
+                dropped: dropped.clone(),
+            });
+            let weak = Arc::downgrade(&stream);
+            let tuple = FourTuple {
+                local_addr: "127.0.0.1:1".parse().unwrap(),
+                peer_addr: "127.0.0.1:2".parse().unwrap(),
+            };
+            inner
+                .driver_event_tx
+                .try_send(PeerConnectionDriverEvent::IncomingTcpStream(tuple, stream))
+                .unwrap();
+            let mut driver = PeerConnectionDriver::new(
+                inner.clone(),
+                Vec::<SocketAddr>::new(),
+                Vec::new(),
+                MulticastDnsMode::Disabled,
+                Vec::new(),
+                RTCIceTransportPolicy::All,
+                rtc::crypto::default_provider().unwrap(),
+                false,
+                None,
+            );
+            let (init_tx, mut init_rx) = channel(1);
+            let inbox = DriverInbox::new(events);
+            let held = Arc::new(HeldSpawn {
+                future: std::sync::Mutex::new(None),
+                finished: AtomicBool::new(false),
+            });
+            let mut rt = hook(
+                run,
+                Box::pin(async { Err(io::Error::other("unused connect boundary")) }),
+            );
+            Arc::get_mut(&mut rt).unwrap().held = Some(held.clone());
+            // Same ownership order as run_driver: guard exists before outer future/spawn.
+            let task = rt.spawn(Box::pin(async move {
+                let _ = driver.event_loop(inbox, init_tx).await;
+            }));
+            assert!(held.future.lock().unwrap().is_some());
+            assert!(!task.is_finished());
+            assert!(init_rx.try_recv().is_err());
+            assert_eq!(
+                dropped.load(Ordering::SeqCst),
+                0,
+                "unpolled outer future owns queued payload"
+            );
+            task.abort();
+            assert!(task.is_finished());
+            assert_eq!(
+                dropped.load(Ordering::SeqCst),
+                1,
+                "CONTROL_UNPOLLED_OUTER_OWNER_RELEASES_INBOX"
+            );
+            assert!(weak.upgrade().is_none());
+            assert!(inner.driver_event_tx.is_closed());
+            assert!(init_rx.recv().await.is_none());
+        }));
+    }
+    #[test]
+    fn actual_driver_inbox_seals_before_empty_drain_and_late_send() {
+        let (tx, rx) = channel(4);
+        let before = Arc::new(AtomicUsize::new(0));
+        let late = Arc::new(AtomicUsize::new(0));
+        let make = |counter: Arc<AtomicUsize>| {
+            Arc::new(TrackedStream {
+                read_polled: Arc::new(AtomicBool::new(false)),
+                dropped: counter,
+            }) as Arc<dyn AsyncTcpStream>
+        };
+        let tuple = FourTuple {
+            local_addr: "127.0.0.1:1".parse().unwrap(),
+            peer_addr: "127.0.0.1:2".parse().unwrap(),
+        };
+        tx.try_send(PeerConnectionDriverEvent::IncomingTcpStream(
+            tuple,
+            make(before.clone()),
+        ))
+        .unwrap();
+        let mut inbox = DriverInbox::new(rx);
+        let rejected = Arc::new(AtomicBool::new(false));
+        let observed = rejected.clone();
+        let late_count = late.clone();
+        inbox.after_drain = Some(Box::new(move || {
+            let event = PeerConnectionDriverEvent::IncomingTcpStream(
+                tuple,
+                Arc::new(TrackedStream {
+                    read_polled: Arc::new(AtomicBool::new(false)),
+                    dropped: late_count,
+                }),
+            );
+            let result = tx.try_send(event);
+            observed.store(
+                matches!(&result, Err(TrySendError::Disconnected(_))),
+                Ordering::SeqCst,
+            );
+            drop(result);
+        }));
+        drop(inbox);
+        assert_eq!(
+            before.load(Ordering::SeqCst),
+            1,
+            "queued payload was actually drained"
+        );
+        assert_eq!(
+            rejected.load(Ordering::SeqCst),
+            true,
+            "CONTROL_QUEUE_SEALED_BEFORE_LATE_SEND"
+        );
+        assert_eq!(
+            late.load(Ordering::SeqCst),
+            1,
+            "rejected late payload dropped with its error"
+        );
+    }
