+            let candidate = |addr: SocketAddr, kind: &str| RTCIceCandidateInit {
+                candidate: format!("candidate:1 1 udp 2130706431 {} {} typ {}{}", addr.ip(), addr.port(), kind, if kind == "relay" { " raddr 127.0.0.1 rport 55003" } else { "" }),
