+pub(crate) struct DriverInbox {
+    receiver: Receiver<PeerConnectionDriverEvent>,
+    #[cfg(test)]
+    after_drain: Option<Box<dyn FnOnce() + Send>>,
+}
+impl DriverInbox {
+    pub(crate) fn new(receiver: Receiver<PeerConnectionDriverEvent>) -> Self {
+        Self {
+            receiver,
+            #[cfg(test)]
+            after_drain: None,
+        }
+    }
+}
+impl std::ops::Deref for DriverInbox {
+    type Target = Receiver<PeerConnectionDriverEvent>;
+    fn deref(&self) -> &Self::Target {
+        &self.receiver
+    }
+}
+impl std::ops::DerefMut for DriverInbox {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        &mut self.receiver
+    }
+}
+impl Drop for DriverInbox {
+    fn drop(&mut self) {
+        self.receiver.close();
+        while let Ok(event) = self.receiver.try_recv() {
+            drop(event);
+        }
+        #[cfg(test)]
+        if let Some(hook) = self.after_drain.take() {
+            hook();
+        }
+    }
+}
