+impl ManagedTurnClient {
+    fn is_pending_allocate_failure(&self, tid: TransactionId) -> bool {
+        if self.gather_finished {
+            return false;
+        }
+        if tid == self.allocate_tid {
+            return true;
+        }
+        // rtc-turn 0.21.1 returns the authenticated Allocate transaction ID from
+        // allocate(): the anonymous attempt's last byte incremented with wrapping.
+        // Its timeout/error events retain the wire ID of that first attempt.
+        // Both stages belong to this allocation, but neither may finish it twice.
+        let mut authenticated_tid = tid;
+        let last = authenticated_tid.0.len() - 1;
+        authenticated_tid.0[last] = authenticated_tid.0[last].wrapping_add(1);
+        authenticated_tid == self.allocate_tid
+    }
