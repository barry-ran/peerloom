+#[cfg(all(test, feature = "runtime-mock", any(feature = "crypto-ring", feature = "crypto-aws-lc-rs")))]
+mod trickle_park_wake_regression {
+    use super::*;
+    use super::super::{PeerConnection, PeerConnectionImpl};
+    use crate::runtime::{Runtime, Mutex, mock::{MockRuntime, MockUDPNetwork}};
+    use rtc::peer_connection::RTCPeerConnectionBuilder;
+    use std::sync::atomic::AtomicUsize;
+    struct WakeCount(AtomicUsize);
+    impl futures::task::ArcWake for WakeCount {
+        fn wake_by_ref(this: &Arc<Self>) { this.0.fetch_add(1, Ordering::SeqCst); }
