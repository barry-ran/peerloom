+    type ConnectFuture = Pin<Box<dyn Future<Output = io::Result<Arc<dyn AsyncTcpStream>>> + Send>>;
+    struct HeldSpawn {
+        future: std::sync::Mutex<Option<Pin<Box<dyn Future<Output = ()> + Send>>>>,
+        finished: AtomicBool,
+    }
+    struct HeldHandle(Arc<HeldSpawn>);
+    impl JoinHandle for HeldHandle {
+        fn detach(&self) {}
+        fn abort(&self) {
+            let future = self.0.future.lock().unwrap().take();
+            drop(future);
+            self.0.finished.store(true, Ordering::SeqCst);
+        }
+        fn is_finished(&self) -> bool {
+            self.0.finished.load(Ordering::SeqCst)
+        }
+    }
+    struct HookRuntime {
+        base: Arc<dyn Runtime>,
+        next: std::sync::Mutex<Option<ConnectFuture>>,
+        spawns: AtomicUsize,
+        held: Option<Arc<HeldSpawn>>,
+    }
+    impl std::fmt::Debug for HookRuntime {
+        fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+            f.write_str("HookRuntime")
+        }
+    }
+    impl Runtime for HookRuntime {
+        fn spawn(&self, f: Pin<Box<dyn Future<Output = ()> + Send>>) -> Box<dyn JoinHandle> {
+            self.spawns.fetch_add(1, Ordering::SeqCst);
+            if let Some(held) = &self.held {
+                assert!(held.future.lock().unwrap().replace(f).is_none());
+                Box::new(HeldHandle(held.clone()))
+            } else {
+                self.base.spawn(f)
+            }
+        }
+        fn wrap_udp_socket(&self, s: std::net::UdpSocket) -> io::Result<Arc<dyn AsyncUdpSocket>> {
+            self.base.wrap_udp_socket(s)
+        }
+        fn wrap_tcp_listener(
