{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "原生 WSS 信令信封",
  "description": "Native ordered WSS signaling. Early SDP followed by bounded session.ice batches. connection_generation/fencing_token fence sockets; negotiation_generation fences ICE. Per direction/generation: 256 candidates and 262144 field UTF-8 bytes. Per batch: 16 items and 16384 payload UTF-8 bytes. complete means actual gathering completion; no later candidates. Recovery uses a new generation; candidate contents are not persisted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "seq",
    "sent_at",
    "payload"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "enum": [
        "hello",
        "hello.ack",
        "presence.heartbeat",
        "presence.ack",
        "session.request",
        "session.pending",
        "session.accept",
        "session.reject",
        "session.offer",
        "session.answer",
        "session.connected",
        "session.reconnecting",
        "session.renew",
        "session.updated",
        "session.terminate",
        "session.terminated",
        "sync.request",
        "sync.snapshot",
        "error",
        "session.ice"
      ]
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "connection_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fencing_token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "negotiation_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "payload": {
      "type": "object",
      "maxProperties": 32
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "connection_generation"
              ]
            },
            {
              "required": [
                "fencing_token"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "connection_generation",
          "fencing_token"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "session.offer",
              "session.answer",
              "session.reconnecting"
            ]
          }
        }
      },
      "then": {
        "required": [
          "session_id",
          "negotiation_generation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "session.offer",
              "session.answer"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "sdp"
            ],
            "properties": {
              "sdp": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "session.connected",
              "session.reconnecting"
            ]
          }
        }
      },
      "then": {
        "required": [
          "session_id"
        ],
        "properties": {
          "payload": {
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "session.ice"
          }
        }
      },
      "then": {
        "required": [
          "session_id",
          "negotiation_generation"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidates",
              "complete"
            ],
            "properties": {
              "candidates": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "candidate",
                    "sdp_mid",
                    "sdp_mline_index",
                    "username_fragment"
                  ],
                  "properties": {
                    "candidate": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "sdp_mid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "sdp_mline_index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    },
                    "username_fragment": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                }
              },
              "complete": {
                "type": "boolean"
              }
            },
            "anyOf": [
              {
                "properties": {
                  "candidates": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "complete": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
