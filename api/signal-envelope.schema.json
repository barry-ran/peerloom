{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "原生 WSS 信令信封",
  "description": "GET /v1/device-signal，Authorization Bearer；native-only，不接受Origin或URL凭证。单节点路由。客户端hello seq0后严格递增；除hello均需服务器发行的generation与fence。SDP仅完整ICE，negotiation_generation为1..9007199254740991；session.reconnecting以当前代请求CAS后重建PeerConnection/Channel，不支持trickle或原地ICE restart。旧connected省略代号仅按1处理。运行时每帧128KiB硬上限、服务端重新鉴权与授权。 独占会话初次sync可省target_epoch但只读；其他独占变更必须canonical epoch且事务内匹配。connect_prepared仅预留source，fence_ack仅原accept的当前WSS运行时在关闭所有gate/流之后提交。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "seq",
    "sent_at",
    "payload"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "enum": [
        "hello",
        "hello.ack",
        "presence.heartbeat",
        "presence.ack",
        "session.request",
        "session.pending",
        "session.accept",
        "session.reject",
        "session.offer",
        "session.answer",
        "session.connected",
        "session.reconnecting",
        "session.renew",
        "session.updated",
        "session.terminate",
        "session.terminated",
        "sync.request",
        "sync.snapshot",
        "error",
        "session.connect_prepared",
        "session.fence_ack"
      ]
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "connection_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fencing_token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "negotiation_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "payload": {
      "type": "object",
      "maxProperties": 32
    },
    "target_epoch": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "maxLength": 19,
      "description": "规范十进制 epoch，运行时额外强制不大于 9223372036854775807；不能当 JSON number。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "connection_generation"
              ]
            },
            {
              "required": [
                "fencing_token"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "connection_generation",
          "fencing_token"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "session.offer",
              "session.answer",
              "session.reconnecting"
            ]
          }
        }
      },
      "then": {
        "required": [
          "session_id",
          "negotiation_generation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "session.offer",
              "session.answer"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "sdp"
            ],
            "properties": {
              "sdp": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "session.connected",
              "session.reconnecting"
            ]
          }
        }
      },
      "then": {
        "required": [
          "session_id"
        ],
        "properties": {
          "payload": {
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "session.connect_prepared",
              "session.fence_ack"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "session_id",
          "target_epoch"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    }
  ]
}
