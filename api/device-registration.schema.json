{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "设备注册输入",
  "description": "支持 grant 注册与应用显式启用的 direct 注册。grant 请求提供非空 registration_grant；direct 省略该字段，HTTP Idempotency-Key 必须是 CSPRNG 32字节的canonical base64url无padding（43字符），该恢复秘密不得日志记录。非空无效grant不会降级direct。schema只验证body，不能证明随机性或跨body/header及应用当前配置；runtime另行实施。metadata仅有限标量字段，入口原始body限16 KiB；公开installation_public_key只作为非认证安装标签哈希。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "platform",
    "installation_public_key"
  ],
  "properties": {
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "platform": {
      "enum": [
        "windows",
        "macos",
        "linux",
        "android",
        "ios",
        "web"
      ]
    },
    "installation_public_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "registration_grant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "非空时仅走grant注册；direct应省略，不使用空字符串或null。grant真伪/过期/应用mode由runtime验证。"
    },
    "sdk_version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[^\\u0000]*$"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[^\\u0000]*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^[^\\u0000]*$"
          },
          {
            "type": "number",
            "minimum": -1.7976931348623157e+308,
            "maximum": 1.7976931348623157e+308
          },
          {
            "type": [
              "boolean",
              "null"
            ]
          }
        ]
      }
    }
  }
}
