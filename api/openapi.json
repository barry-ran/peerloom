  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Registration": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "设备注册输入",
        "description": "M1 当前只实现 grant 注册；metadata 仅有限标量字段。16 KiB 原始请求体上限由 HTTP 入口实施。installation_public_key 当前仅作为不透明安装标签哈希，不验证算法，也不用于认证或恢复。",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application_id",
          "platform",
          "installation_public_key",
          "registration_grant"
        ],
        "properties": {
          "application_id": {
            "type": "string",
            "format": "uuid"
          },
          "platform": {
            "enum": [
              "windows",
              "macos",
              "linux",
              "android",
              "ios",
              "web"
            ]
          },
          "installation_public_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "registration_grant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sdk_version": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[^\\u0000]*$"
          },
          "metadata": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000]*$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1024,
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              ]
            }
          }
        }
      },
      "Credential": {
        "type": "object",
        "required": [
          "device_id",
          "device_credential",
          "expires_at"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "device_credential": {
            "type": "string",
            "pattern": "^dev_[A-Za-z0-9_-]{43}$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Device": {
        "type": "object",
        "required": [
          "device_id",
          "tenant_id",
          "application_id",
          "platform",
          "metadata"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "application_id": {
            "type": "string",
            "format": "uuid"
          },
          "platform": {
            "enum": [
              "windows",
              "macos",
              "linux",
              "android",
              "ios",
              "web"
            ]
          },
          "metadata": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000]*$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1024,
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              ]
            }
          }
        }
      },
      "IdentityProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Problem"
          },
          {
            "type": "object",
            "required": [
              "request_id",
              "detail"
            ],
            "properties": {
              "request_id": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "securitySchemes": {
      "DeviceCredential": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque dev_ token"
      }
    }
  }
}
