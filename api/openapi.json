    "/v1/device-credentials/refresh": {
      "post": {
        "summary": "轮换设备凭证；旧凭证仅短暂重叠",
        "security": [
          {
            "DeviceCredential": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "description": "相同授权上下文与逻辑请求使用相同键；不能用新键再次消费一次性 grant。"
          }
        ],
        "requestBody": {
          "required": false,
          "description": "须 Content-Type: application/json；允许空请求体或空对象",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功；凭证响应禁止缓存或日志记录",
