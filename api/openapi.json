{
  "openapi": "3.1.0",
  "info": {
    "title": "Peerloom 基础与设备身份接口",
    "version": "0.1.0-dev",
    "description": "已实现健康与 grant-only 身份服务。没有管理后台、direct 注册、WSS 或平台授权 WebRTC 连接入口。"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "进程存活，不代表产品可用",
        "responses": {
          "200": {
            "description": "进程存活，不代表产品可用",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "const": "alive"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "仅 PostgreSQL schema 就绪，不代表信令或中继可用",
        "responses": {
          "200": {
            "description": "仅 PostgreSQL schema 就绪，不代表信令或中继可用",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "scope"
                  ],
                  "properties": {
                    "status": {
                      "const": "ready"
                    },
                    "scope": {
                      "const": "postgres_schema"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "停止中或数据库 schema 未就绪",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "内部 Prometheus 指标，网关不得对外代理",
        "responses": {
          "200": {
            "description": "HTTP 请求计数",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/device-registrations": {
      "post": {
        "summary": "使用一次性 grant 原子注册安装身份",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "description": "相同授权上下文与逻辑请求使用相同键；不能用新键再次消费一次性 grant。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "成功；凭证响应禁止缓存或日志记录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Credential"
                }
              }
            }
          },
          "401": {
            "description": "认证、输入、幂等或依赖失败，按稳定 code 判断",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblem"
                }
              }
            }
          },
          "403": {
            "description": "认证、输入、幂等或依赖失败，按稳定 code 判断",
            "content": {
