+
+    // Private ownership handoff for already-framed streams. Keep the public slice
+    // API and the same atomic try_send/backpressure and timeout semantics.
+    async fn send_owned(&self, payload: BytesMut) -> Result<(), TransportError> {
+        if payload.len() > self.max_message_bytes {
+            return Err(TransportError::MessageTooLarge);
+        }
+        tokio::time::timeout(self.timeout, self.channel.try_send(payload))
             .await
             .map_err(|_| TransportError::Timeout)?
             .map_err(classify_backend)
