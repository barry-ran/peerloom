+    // Private ownership handoff for full-sized stream DATA frames. The public
+    // slice API, atomic enqueue/backpressure and timeout handling stay unchanged.
+    async fn send_owned_frame(&self, frame: Vec<u8>) -> Result<(), TransportError> {
+        if frame.len() > self.max_message_bytes {
+            return Err(TransportError::MessageTooLarge);
+        }
+        let payload = owned_frame_bytes(frame);
+        tokio::time::timeout(self.timeout, self.channel.try_send(payload))
+            .await
+            .map_err(|_| TransportError::Timeout)?
+            .map_err(classify_backend)
+    }
